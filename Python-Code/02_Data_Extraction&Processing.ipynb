    "# Def function to convert currency\n",
    "def convert_currency(_currency):\n",
    "  if _currency == \"@@000000013\":\n",
    "    return \"hbd\"\n",
    "  elif _currency == \"@@000000021\":\n",
    "    return \"hive\"\n",
    "  else:\n",
    "    return \"Error parsing currency\""
